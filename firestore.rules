rules_version = '2';

// Security rules for the modular Lab Inventory.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
// Who can do what:
//   admin  – everything, including modules, people (invites/roles) and lab settings
//   member – add and edit items, experiments and projects
//   viewer – read only
// Someone who is not a member (not invited) cannot read anything except the lab name.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function isMember() { return signedIn() && exists(memberPath(request.auth.uid)); }
    function myRole() { return get(memberPath(request.auth.uid)).data.role; }
    function isAdmin() { return isMember() && myRole() == 'admin'; }
    function canEdit() { return isMember() && myRole() in ['admin', 'member']; }
    function myEmail() { return request.auth.token.email.lower(); }
    function emailVerified() { return request.auth.token.email_verified == true; }
    function labPath() { return /databases/$(database)/documents/meta/lab; }
    function invitePath() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function validRole(r) { return r in ['admin', 'member', 'viewer']; }

    // Lab name and owner. Created once, by the first person who sets up the lab.
    match /meta/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && docId == 'lab' && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // One document per person, keyed by their user ID.
    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow create: if validRole(request.resource.data.role) && (
        isAdmin()
        // The very first admin, created in the same batch as /meta/lab during setup.
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'admin'
            && !exists(labPath())
            && getAfter(labPath()).data.ownerUid == request.auth.uid)
        // Someone accepting an invite: only with a confirmed email and exactly the invited role.
        || (signedIn() && request.auth.uid == uid && emailVerified()
            && exists(invitePath())
            && request.resource.data.role == get(invitePath()).data.role)
      );
      allow update: if (isAdmin() && validRole(request.resource.data.role))
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Invites, keyed by lower-case email address.
    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, update: if isAdmin() && validRole(request.resource.data.role);
      allow delete: if isAdmin();
    }

    // Module definitions: only admins may change them.
    match /modules/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Inventory items, experiments and projects.
    match /records/{id} {
      allow read: if isMember();
      allow write: if canEdit();
    }
    match /experiments/{id} {
      allow read: if isMember();
      allow write: if canEdit();
    }
    match /projects/{id} {
      allow read: if isMember();
      allow write: if canEdit();
    }

    // Activity log: members add entries; only admins can change or remove them.
    match /log/{id} {
      allow read: if isMember();
      allow create: if canEdit();
      allow update, delete: if isAdmin();
    }
  }
}
